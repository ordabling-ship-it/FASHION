# ---------------------------------------------------------------------------
# VTON Studio Reels — copy to .env and fill in. Never commit real keys.
# All variables are validated with zod at startup (src/server/config.ts).
# ---------------------------------------------------------------------------

# Server
PORT=3000
# NODE_ENV=production   # set automatically by `npm start`

# DEMO_MODE=true uses offline mock providers (no API keys, placeholder output,
# clearly labeled in the UI). Set to false to call the real AI providers below.
DEMO_MODE=true

# Folders
INPUT_DIR=./input          # drop clothing photos here (subfolder or name prefix = one item)
OUTPUT_DIR=./output        # reels + script + caption + metadata per item
DATA_DIR=./data            # job queue / item store (db.json)
WATCH_INPUT=true           # watch INPUT_DIR with chokidar while the server runs
REVIEW_BEFORE_RENDER=false # true = stop after the script so you can edit it in the dashboard
MAX_RETRIES=2              # retries per pipeline step

# Reel content
REEL_LANGUAGE=pl           # pl | en (per item override: "language" in info.json)
DEFAULT_CURRENCY=PLN

# Step 2 + 4: garment analysis & script — Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Step 3: virtual try-on — fal | replicate | mock
VTON_PROVIDER=fal
FAL_KEY=                                   # https://fal.ai/dashboard/keys
FAL_VTON_MODEL=fal-ai/cat-vton             # or fal-ai/idm-vton
REPLICATE_API_TOKEN=                       # https://replicate.com/account/api-tokens
REPLICATE_VTON_MODEL=cuuupid/idm-vton:0513734a452173b8173e907e3a59d19a36266e55b48528559432bd21c7d7e985
# Photo of the (AI) model/avatar who wears the clothes. You must own the rights to this likeness.
MODEL_AVATAR_PATH=./assets/model.jpg

# Step 5: voiceover — elevenlabs | mock
TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=                        # https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL   # pick an energetic female voice from your Voice Library
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Step 5: lip-synced talking video — fal | none (none = animated still image)
LIPSYNC_PROVIDER=fal
FAL_LIPSYNC_MODEL=veed/fabric-1.0

# Step 5: rendering (ffmpeg must be installed and built with libass)
MUSIC_PATH=                                # optional royalty-free background track (mp3)
MUSIC_VOLUME=0.12
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

RATE_LIMIT_PER_MINUTE=120

# Legacy demo features (still simulated — see README)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
